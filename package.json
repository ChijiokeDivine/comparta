{
  "name": "comparta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prisma:clean": "node -e \"try{require('fs').rmSync('app/generated/prisma',{recursive:true,force:true})}catch(e){process.exit(0)}\"",
    "prisma:generate": "pnpm run prisma:clean && prisma generate",
    "postinstall": "pnpm run prisma:generate",
    "build": "pnpm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint"
  },
