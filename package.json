    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.109.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "groq-sdk": "^1.3.0",
    "gsap": "^3.15.0",
    "ioredis": "^5.11.1",
    "lenis": "^1.3.25",
