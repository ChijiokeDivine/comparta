# ─────────────────────────────────────────────────────────────────────
# Comparta environment
#
# Network selection (lib/config/network.ts):
#   - local dev / Vercel preview  → Arc testnet (automatic)
#   - Vercel production           → Arc mainnet  (automatic via VERCEL_ENV)
#   - ARC_NETWORK=testnet|mainnet → explicit override (use for one-off checks)
#
# Credentials are stored side by side in Infisical and injected at deploy
# time: the un-suffixed names hold SANDBOX values, `_MAIN` holds LIVE ones.
# Never put live keys in this file or in a local .env.
# ─────────────────────────────────────────────────────────────────────

DATABASE_URL=
DIRECT_URL=
REDIS_URL=
# Local dev only: set to true to skip Redis entirely (no server needed).
# Rate limiting + the yield-rate cache use in-process memory, realtime stays
# single-process, and background job enqueues are skipped. Never in production.
REDIS_DISABLED=false

NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Circle: sandbox (local dev + preview) ───────────────────────────
CIRCLE_API_KEY=
CIRCLE_CLIENT_KEY=
CIRCLE_ENTITY_SECRET=

# ── Circle: mainnet (production only, injected by Infisical) ────────
# These are the ONLY credentials duplicated per network. There is no
# fallback: a production build without them fails at startup.
CIRCLE_API_KEY_MAIN=
CIRCLE_CLIENT_KEY_MAIN=
CIRCLE_ENTITY_SECRET_MAIN=

# ── Circle: shared config (same on both networks) ───────────────────
CIRCLE_APP_ID=
CIRCLE_USDC_TOKEN_ID=
CIRCLE_WALLET_SET_ID=

# ── Circle Onramp (buy USDC with card/bank) ─────────────────────────
# Enabled by default; set to "false" to hide the card/bank checkout.
ONRAMP_ENABLED=
# Optional dedicated Onramp API key. When blank, the active network's
# CIRCLE_API_KEY is used (CIRCLE_API_KEY_MAIN on mainnet). The key must be
# enabled for App Kits in the Circle Console.
CIRCLE_ONRAMP_API_KEY=
# Bare hostname allowed to embed the widget (no scheme/port/path).
# Defaults to the hostname of NEXTAUTH_URL. In production this hostname
# must also be registered in your Circle Onramp KYB `web_url` entries.
ONRAMP_REFERRER_DOMAIN=

# ── Paj Cash (Nigerian bank onramp / offramp) ───────────────────────
# Optional: the bank tabs hide themselves when this is blank. Server-side
# only — never expose the key to the browser. Rates returned by Paj already
# include the business fee configured on the key.
PAJ_CASH_API_KEY=
# "production" (pairs with Arc mainnet) or "staging" (pairs with Arc
# testnet). Must match the resolved network or bank transfers stay off.
# Defaults to "production" when unset.
# PAJ_CASH_ENVIRONMENT=production
# Optional override for the HMAC secret (starts with "whsec_") used to verify
# /api/webhooks/paj. Leave blank in the normal case: Comparta registers the
# ramp webhook with Paj (PATCH /pub/v2/webhook), receives the key's secret, and
# stores it encrypted in PajWebhookConfig. Set it only when the key's webhook
# is managed elsewhere — a value that doesn't match the key's real secret makes
# every delivery fail verification (Settings → Webhooks flags the mismatch).
PAJ_CASH_WEBHOOK_SECRET=
# Optional public URL Paj posts order updates to. Defaults to
# ${NEXTAUTH_URL}/api/webhooks/paj. Must be the FINAL https URL: Paj does not
# follow redirects, and localhost/non-https URLs are treated as unreachable.
# PAJ_WEBHOOK_URL=https://app.example.com/api/webhooks/paj
# Point the API key's ramp webhook at the URL above before opening an order.
# Runs on mainnet, or whenever PAJ_WEBHOOK_URL is explicit; "false" disables it.
# PAJ_CASH_WEBHOOK_AUTO_REGISTER=true

# CIRCLE_ENVIRONMENT and ARC_CHAIN are DERIVED from the resolved network —
# do not set them; a contradicting value fails startup.

# ── Arc RPC endpoints ───────────────────────────────────────────────
# Both are optional: each falls back to Circle's public endpoint
# (https://rpc.testnet.arc.io / https://rpc.mainnet.arc.io).
ARC_TESTNET_RPC=
ARC_MAINNET_RPC=

# ── On-chain protocol deployments (per network) ─────────────────────
AGREEMENT_CORE_ADDRESS=
CONDITIONAL_MODULE_ADDRESS=
STREAM_MODULE_ADDRESS=
# Defaults to 0x3600…0000 (the USDC predeploy on both Arc networks).
ONCHAIN_USDC_ADDRESS=
ONCHAIN_OPERATOR_PRIVATE_KEY=

GROQ_API_KEY=
ADMIN_API_SECRET=
